# 生产环境配置
# API 地址（通过 nginx 代理，使用相对路径）
NEXT_PUBLIC_API_URL=/app-api

# 追踪代理请求的默认租户 ID
NEXT_PUBLIC_TENANT_ID=1

# 追踪链接重定向校验开关
NEXT_PUBLIC_TRACKING_REDIRECT_VALIDATE=true

# 重定向校验不允许 http
NEXT_PUBLIC_TRACKING_REDIRECT_ALLOW_HTTP=false

# 允许重定向域名白名单（逗号分隔）
NEXT_PUBLIC_TRACKING_REDIRECT_DOMAINS=deals.ecommica.com,ecommica.com
